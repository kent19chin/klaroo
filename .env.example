# Copy to .env.local for local work. Add the same values in Vercel under
# Project Settings > Environment Variables, then run: npm run db:migrate

# Neon Postgres connection string (the pooled one).
DATABASE_URL=

# Base URL for sign-in links. Defaults to https://klarooo.com if left out.
# For local work: http://localhost:3000
APP_URL=

# Resend, which sends the sign-in emails. Without a key, dev prints the link in
# the terminal and production can't sign anyone in.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM=klarooo <noreply@klarooo.com>

# Vercel Blob, for images in blog posts. Without it, uploads show an error.
BLOB_READ_WRITE_TOKEN=
